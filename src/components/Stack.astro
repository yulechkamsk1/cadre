---
import type { SiteContent } from '../content/data';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const headingId = `stack-heading-${content.htmlLang}`;
---

<section aria-labelledby={headingId} data-reveal>
  <div class="wrap">
    <h2 id={headingId} class="section-title">{content.stack.title}</h2>
    <div class="stack-grid">
      {
        content.stack.groups.map((group) => (
          <div class="stack-group">
            <h3 class="stack-group__title mono">{group.title}</h3>
            <p class="stack-group__items">{group.items.join(', ')}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
