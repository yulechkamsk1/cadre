---
import { Picture } from 'astro:assets';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

const photoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png}', {
  eager: true,
});
const photoKey = Object.keys(photoModules)[0];
const photo = photoKey ? photoModules[photoKey].default : null;
---

<div class="hero__photo">
  {
    photo ? (
      <Picture
        src={photo}
        alt={alt}
        width={320}
        height={400}
        fit="cover"
        position="top"
        formats={['webp']}
        fallbackFormat="jpg"
        loading="eager"
      />
    ) : (
      <div class="hero__photo-placeholder" aria-hidden="true" />
    )
  }
</div>
