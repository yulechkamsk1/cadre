---
import type { SiteContent } from '../content/data';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const headingId = `about-heading-${content.htmlLang}`;
---

<section aria-labelledby={headingId} data-reveal>
  <div class="wrap">
    <h2 id={headingId} class="section-title">
      <span class="reveal-mask"><span class="reveal-mask__inner">{content.about.title}</span></span>
    </h2>
    <div class="about__body">
      {content.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
